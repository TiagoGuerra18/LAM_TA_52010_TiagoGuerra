<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:orientation="vertical" android:padding="@dimen/spacing_m">
<TextView android:id="@+id/exGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/ex_body_size"/>
<TextView android:id="@+id/exLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_s" android:textSize="@dimen/ex_title_size" android:textStyle="bold" android:accessibilityHeading="true"/>
<TextView android:id="@+id/exOffline" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/spacing_s" android:background="@color/ex_warning" android:textColor="@color/ex_warning_text" android:text="@string/banner_offline" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
<TextView android:id="@+id/exBattery" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/spacing_s" android:background="@color/ex_warning" android:textColor="@color/ex_warning_text" android:text="@string/ex_battery_low" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
<TextView android:id="@+id/exStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ex_idle" android:accessibilityLiveRegion="polite" android:textSize="@dimen/ex_caption_size"/>
<ProgressBar android:id="@+id/exProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" android:contentDescription="@string/cd_weather_progress"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<Button android:id="@+id/exRefresh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/menu_refresh" android:minHeight="@dimen/touch_target"/>
<Button android:id="@+id/exCancel" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_s" android:text="@string/ex_cancel" android:minHeight="@dimen/touch_target"/>
</LinearLayout>
<ListView android:id="@+id/forecastList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="@dimen/spacing_s" android:layoutAnimation="@anim/ex_list" android:clipToPadding="false"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ex_attribution" android:textSize="@dimen/ex_caption_size" android:gravity="center"/>
</LinearLayout>
