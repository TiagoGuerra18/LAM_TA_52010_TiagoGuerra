<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailPanel" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="@dimen/spacing_m" android:orientation="vertical" android:background="@drawable/bg_explorer_card">
    <TextView android:id="@+id/detailHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/ex_body_size" android:textStyle="bold" android:accessibilityHeading="true"/>
    <TextView android:id="@+id/detailStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/ex_caption_size" android:accessibilityLiveRegion="polite"/>
    <ProgressBar android:id="@+id/detailProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" android:contentDescription="@string/cd_weather_progress"/>
    <Button android:id="@+id/detailFavorite" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ex_add_favorite" android:minHeight="@dimen/touch_target"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/detailRetry" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ex_retry" android:minHeight="@dimen/touch_target"/>
        <Button android:id="@+id/detailCancel" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ex_cancel" android:minHeight="@dimen/touch_target"/>
    </LinearLayout>
    <ScrollView android:id="@+id/hoursScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/hoursContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
</LinearLayout>
